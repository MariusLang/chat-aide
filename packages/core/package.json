{
	"name": "@chat-aide/core",
	"version": "0.1.0",
	"description": "The framework-neutral core of chat-aide: an AI chat and llms.txt for your own site, derived from the site at run time.",
	"license": "MIT",
	"homepage": "https://chat-aide.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MariusLang/chat-aide.git",
		"directory": "packages/core"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/server/browser-guard.js",
			"default": "./dist/index.js"
		},
		"./llms": {
			"types": "./dist/llms/index.d.ts",
			"browser": "./dist/server/browser-guard.js",
			"default": "./dist/llms/index.js"
		},
		"./internal": {
			"types": "./dist/internal.d.ts",
			"browser": "./dist/server/browser-guard.js",
			"default": "./dist/internal.js"
		},
		"./extract": {
			"types": "./dist/extract/index.d.ts",
			"default": "./dist/extract/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./plain.css": "./dist/themes/plain.css"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint .",
		"pretest": "test -f dist/index.js || pnpm build",
		"test": "vitest run",
		"publint": "publint",
		"prepack": "cp ../../README.md ../../LICENSE ."
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "^5.0.97",
		"@ai-sdk/anthropic": "^4.0.65",
		"@ai-sdk/azure": "^4.0.82",
		"@ai-sdk/baseten": "^2.1.35",
		"@ai-sdk/cerebras": "^3.0.57",
		"@ai-sdk/cohere": "^4.0.50",
		"@ai-sdk/deepinfra": "^3.0.57",
		"@ai-sdk/deepseek": "^3.0.54",
		"@ai-sdk/fireworks": "^3.0.60",
		"@ai-sdk/google": "^4.0.82",
		"@ai-sdk/google-vertex": "^5.0.95",
		"@ai-sdk/groq": "^4.0.50",
		"@ai-sdk/huggingface": "^2.0.57",
		"@ai-sdk/mistral": "^4.0.52",
		"@ai-sdk/openai": "^4.0.78",
		"@ai-sdk/openai-compatible": "^3.0.57",
		"@ai-sdk/perplexity": "^5.0.0",
		"@ai-sdk/togetherai": "^3.0.58",
		"@ai-sdk/xai": "^5.0.10",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"ai": "^7.0.116",
		"linkedom": "^0.18.13",
		"marked": "^18.0.14",
		"zod": "^4.6.6"
	},
	"peerDependencies": {
		"@vercel/functions": "^3"
	},
	"peerDependenciesMeta": {
		"@vercel/functions": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^24.19.0",
		"@vercel/functions": "^3.9.9",
		"eslint": "^10.11.0",
		"happy-dom": "^20.14.5",
		"publint": "^0.3.24",
		"typescript": "~6.0.3",
		"vitest": "^5.0.2"
	}
}
