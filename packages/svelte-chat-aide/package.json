{
  "name": "svelte-chat-aide",
  "version": "0.0.0",
  "description": "An AI chat and llms.txt for your own SvelteKit site, derived from the site at run time.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "browser": "./dist/server/browser-guard.js",
      "default": "./dist/server/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "svelte": "./dist/headless/index.js",
      "default": "./dist/headless/index.js"
    },
    "./themes/plain": {
      "types": "./dist/themes/plain/index.d.ts",
      "svelte": "./dist/themes/plain/index.js",
      "default": "./dist/themes/plain/index.js"
    },
    "./themes/plain/plain.css": "./dist/themes/plain/plain.css",
    "./themes/shadcn": {
      "types": "./dist/themes/shadcn/index.d.ts",
      "svelte": "./dist/themes/shadcn/index.js",
      "default": "./dist/themes/shadcn/index.js"
    },
    "./llms": {
      "types": "./dist/llms/index.d.ts",
      "default": "./dist/llms/index.js"
    },
    "./extract": {
      "types": "./dist/extract/index.d.ts",
      "default": "./dist/extract/index.js"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-css.mjs && svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "pretest": "test -f dist/themes/shadcn/styles.css || pnpm build",
    "test": "vitest run",
    "publint": "publint"
  },
  "dependencies": {
    "@ai-sdk/svelte": "^5.0.116",
    "@lucide/svelte": "^1.48.0",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "linkedom": "^0.18.13",
    "marked": "^18.0.14",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@ai-sdk/amazon-bedrock": "^5",
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/azure": "^4",
    "@ai-sdk/baseten": "^2",
    "@ai-sdk/cerebras": "^3",
    "@ai-sdk/cohere": "^4",
    "@ai-sdk/deepinfra": "^3",
    "@ai-sdk/deepseek": "^3",
    "@ai-sdk/fireworks": "^3",
    "@ai-sdk/google": "^4",
    "@ai-sdk/google-vertex": "^5",
    "@ai-sdk/groq": "^4",
    "@ai-sdk/huggingface": "^2",
    "@ai-sdk/mistral": "^4",
    "@ai-sdk/openai": "^4",
    "@ai-sdk/openai-compatible": "^3",
    "@ai-sdk/perplexity": "^5",
    "@ai-sdk/togetherai": "^3",
    "@ai-sdk/xai": "^5",
    "@openrouter/ai-sdk-provider": "^3",
    "@sveltejs/kit": "^2",
    "@vercel/functions": "^3",
    "ai": "^7",
    "svelte": "^5"
  },
