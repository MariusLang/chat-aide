    "@ai-sdk/azure": "^4.0.82",
    "@ai-sdk/baseten": "^2.1.35",
    "@ai-sdk/cerebras": "^3.0.57",
    "@ai-sdk/cohere": "^4.0.50",
    "@ai-sdk/deepinfra": "^3.0.57",
    "@ai-sdk/deepseek": "^3.0.54",
    "@ai-sdk/fireworks": "^3.0.60",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/google-vertex": "^5.0.95",
    "@ai-sdk/groq": "^4.0.50",
