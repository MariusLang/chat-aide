    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/perplexity": "^5.0.0",
    "@ai-sdk/togetherai": "^3.0.58",
    "@ai-sdk/xai": "^5.0.10",
    "@eslint/js": "^10.0.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.19.0",
