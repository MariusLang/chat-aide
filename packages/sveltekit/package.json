{
	"name": "@chat-aide/sveltekit",
	"version": "0.0.0",
	"description": "An AI chat and llms.txt for your own SvelteKit site, derived from the site at run time.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"browser": "./dist/server/browser-guard.js",
			"default": "./dist/server/index.js"
		},
		"./headless": {
			"types": "./dist/headless/index.d.ts",
			"svelte": "./dist/headless/index.js",
			"default": "./dist/headless/index.js"
		},
		"./themes/plain": {
			"types": "./dist/themes/plain/index.d.ts",
			"svelte": "./dist/themes/plain/index.js",
			"default": "./dist/themes/plain/index.js"
		},
		"./themes/plain/plain.css": "./dist/themes/plain/plain.css",
		"./themes/shadcn": {
			"types": "./dist/themes/shadcn/index.d.ts",
			"svelte": "./dist/themes/shadcn/index.js",
			"default": "./dist/themes/shadcn/index.js"
		},
		"./llms": {
			"types": "./dist/llms/index.d.ts",
			"default": "./dist/llms/index.js"
		},
		"./extract": {
			"types": "./dist/extract/index.d.ts",
			"default": "./dist/extract/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/build-css.mjs && node scripts/copy-plain-css.mjs && svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"pretest": "test -f dist/themes/shadcn/styles.css || pnpm build",
		"test": "vitest run",
		"publint": "publint"
	},
	"dependencies": {
		"@ai-sdk/svelte": "^5.0.116",
		"@chat-aide/core": "workspace:*",
		"@lucide/svelte": "^1.48.0",
		"ai": "^7.0.116",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2",
		"svelte": "^5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/cli": "^4.3.3",
		"@types/node": "^24.19.0",
		"@vercel/functions": "^3.9.9",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.5",
		"linkedom": "^0.18.13",
		"publint": "^0.3.24",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.3",
		"vitest": "^5.0.2"
	}
}
