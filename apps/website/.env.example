# The chat shows only when all of the variables below are set. Without them the site still runs,
# with the chat hidden. See docs/deployment.md#vercel.

# The chat's provider (see docs/providers.md). The site includes the Anthropic and OpenRouter adapters.
CHAT_AIDE_PROVIDER=anthropic
CHAT_AIDE_MODEL=claude-haiku-4-5
CHAT_AIDE_API_KEY=

# The public origin in production, e.g. https://chat-aide.dev
ORIGIN=

# Shared rate limits, budgets and page cache across Vercel's instances. Set by the Upstash for
# Redis integration on Vercel; the token must be the read-write one.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# A long random secret: openssl rand -hex 32
AIDE_SALT=

# 1 = show the chat with a fixed-answer model and no key, for working on the site
AIDE_PREVIEW=
