# The chat's provider (see docs/providers.md). Without these the site runs with the chat hidden.
SVELTE_CHAT_AIDE_PROVIDER=anthropic
SVELTE_CHAT_AIDE_MODEL=claude-haiku-4-5
SVELTE_CHAT_AIDE_API_KEY=

# The public origin in production, e.g. https://chat-aide.dev
ORIGIN=

# 1 = show the chat with a fixed-answer model, for working on the site without a key
AIDE_PREVIEW=
